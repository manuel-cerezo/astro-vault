{
  "name": "astro-vault-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter astro-vault build",
    "check": "pnpm --filter astro-vault check",
    "test": "pnpm --filter astro-vault test",
    "test:example": "pnpm build && pnpm --filter example-basic build && pnpm --filter example-basic test",
    "validate": "pnpm format:check && pnpm check && pnpm test && pnpm test:example",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "release": "git fetch origin && git push origin origin/develop:refs/heads/main"
  },
  "devDependencies": {
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.1",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3"
  }
}
